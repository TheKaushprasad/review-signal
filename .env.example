# ---- Review Signal configuration ----
# Copy to .env and fill in what you need. The app runs with NONE of these set
# (offline mock classifier + CSV upload).

# Server port
PORT=3000

# Classifier engine: "mock" (offline, no key) or "jev" (TypeSafe AI)
CLASSIFIER=mock

# --- Jev by TypeSafe AI (only needed when CLASSIFIER=jev) ---
# Get a key from https://docs.typesafe.ai
TYPESAFE_API_KEY=
# Endpoint (default shown). You can also point this at a LiteLLM / Netlify
# AI Gateway pass-through URL and use that gateway's key above.
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_CONCURRENCY=5

# --- Google Sheets (only needed to load/write Google Sheets) ---
# Absolute path to a Google Cloud service-account JSON key with the
# Sheets API enabled. Share each target spreadsheet with the service
# account's client_email as an Editor.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Supabase (accounts + saved datasets; optional) ---
# From your Supabase project → Project Settings → API.
# Leave blank to run guest-only (in-memory, no login). Run supabase/schema.sql
# in the SQL Editor first. The anon key is browser-safe; the service-role key
# is secret and stays server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
